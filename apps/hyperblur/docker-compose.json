{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "hyperblur",
      "image": "ghcr.io/dan1165/hyperblur:latest",
      "isMain": true,
      "internalPort": 8000,
      "environment": [
        {
          "key": "HYPERBLUR_TUMBLR_API_TOKEN",
          "value": "${HYPERBLUR_TUMBLR_API_TOKEN}"
        }
      ]
    }
  ]
}
